<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@color/line_strong" /><corners android:radius="@dimen/radius" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/ink_pressed" /><corners android:radius="@dimen/radius" /></shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item><shape><solid android:color="@color/ink" /><corners android:radius="@dimen/radius" /></shape></item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape><stroke android:width="2dp" android:color="@color/on_ink" /><corners android:radius="4dp" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape><solid android:color="@color/ink" /><corners android:radius="@dimen/radius" /></shape>
    </item>
</selector>
