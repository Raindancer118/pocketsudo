<?xml version="1.0" encoding="utf-8"?>
<!-- ring draws in 400 ms, the tick follows; ease-out like everything else -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" android:drawable="@drawable/check">
    <target android:name="ring">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator android:duration="400" android:interpolator="@interpolator/ease_out"
                android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="tick">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator android:duration="260" android:startOffset="220" android:interpolator="@interpolator/ease_out"
                android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
