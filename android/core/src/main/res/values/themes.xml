<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PocketSudo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="colorPrimary">@color/ink</item>
        <item name="colorAccent">@color/ink</item>
        <item name="android:textColorPrimary">@color/text1</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:colorControlHighlight">@color/surface2</item>
    </style>

    <style name="Text" parent="">
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textColor">@color/text1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Text.Small">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text3</item>
    </style>
    <style name="Text.Host">
        <item name="android:textSize">33sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="Text.Wordmark">
        <item name="android:textSize">17sp</item>
        <item name="android:textFontWeight">600</item>
    </style>
    <style name="Text.Command">
        <item name="android:fontFamily">@font/mono</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:breakStrategy">balanced</item>
        <item name="android:hyphenationFrequency">none</item>
    </style>
    <style name="Text.Code">
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="android:textSize">64sp</item>
    </style>
    <style name="Text.Link">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:background">@drawable/bg_link</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@animator/press</item>
    </style>

    <style name="Button" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_h</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:paddingStart">26dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:stateListAnimator">@animator/press</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="Button.Primary">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/on_ink</item>
        <item name="android:drawableTint">@color/on_ink</item>
    </style>
</resources>
