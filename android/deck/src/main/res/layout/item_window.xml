<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginBottom="14dp"
        android:background="@color/line" />

    <TextView
        android:id="@+id/win_title"
        style="@style/Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/win_where"
        style="@style/Text.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/win_move"
            style="@style/Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/win_move"
            android:textColor="@color/text1"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/win_close"
            style="@style/Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/win_close"
            android:textColor="@color/text1"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/win_kill"
            style="@style/Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_danger"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/win_kill"
            android:textColor="@color/on_ink"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
