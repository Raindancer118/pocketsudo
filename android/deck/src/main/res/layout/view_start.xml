<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <TextView
        android:id="@+id/host"
        style="@style/Text.Host"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/status"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:textColor="@color/text2"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/lock_button"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="@string/unlock"
        android:stateListAnimator="@animator/press" />

    <TextView
        android:id="@+id/lock_label"
        style="@style/Text.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <!-- quick settings: tap switches, hold opens the details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/qs_wifi"
            style="@style/QuickTile"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/qs_bt"
            style="@style/QuickTile"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/qs_dnd"
            style="@style/QuickTile"
            android:layout_marginEnd="0dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/qs_night"
            style="@style/QuickTile"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/qs_power"
            style="@style/QuickTile"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/qs_audio"
            style="@style/QuickTile"
            android:layout_marginEnd="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/text2"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
