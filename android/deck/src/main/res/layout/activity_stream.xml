<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stream_root"
    tools:ignore="MergeRootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- starts full size so the surface exists; fitVideo() then shrinks it to the picture -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- touch layer above the video -->
    <View
        android:id="@+id/touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- source picker, shown before the stream starts -->
    <LinearLayout
        android:id="@+id/picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:fitsSystemWindows="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stream_source" />

        <LinearLayout
            android:id="@+id/sources"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="vertical" />

        <TextView
            style="@style/Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/stream_audio" />

        <LinearLayout
            android:id="@+id/audios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/start"
            style="@style/Button.Primary"
            android:layout_marginTop="36dp"
            android:text="@string/stream_start" />

        <TextView
            android:id="@+id/picker_message"
            style="@style/Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- slim bar over the running stream -->
    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="@drawable/bg_stream_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/stream_state"
            style="@style/Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:drawablePadding="6dp"
            android:textColor="#FFE6E6E6" />

        <ImageButton
            android:id="@+id/switch_source"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="@string/switch_source"
            android:src="@drawable/ic_switch_light" />

        <ImageButton
            android:id="@+id/kbd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="@string/keyboard"
            android:src="@drawable/ic_keyboard_light" />

        <ImageButton
            android:id="@+id/stop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="@string/stream_stop"
            android:src="@drawable/ic_x_light" />
    </LinearLayout>
    <!-- live source switcher -->
    <HorizontalScrollView
        android:id="@+id/switcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC161616"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/switch_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </HorizontalScrollView>
</FrameLayout>
